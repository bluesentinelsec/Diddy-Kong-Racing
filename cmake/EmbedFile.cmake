# Turns a file into a C header holding its bytes, so shaders (and anything else)
# ship inside the executable instead of beside it.
#
#   cmake -DINPUT=<file> -DOUTPUT=<header> -DSYMBOL=<identifier> -P EmbedFile.cmake
#
# The header defines:
#   static const unsigned char <SYMBOL>[] = { ... , 0x00 };   (NUL-terminated)
#   static const unsigned int  <SYMBOL>_len = <bytes, excluding the NUL>;

if(NOT INPUT OR NOT OUTPUT OR NOT SYMBOL)
    message(FATAL_ERROR "EmbedFile.cmake needs -DINPUT, -DOUTPUT and -DSYMBOL")
endif()

file(READ "${INPUT}" HEX_CONTENT HEX)
string(LENGTH "${HEX_CONTENT}" HEX_LENGTH)
math(EXPR BYTE_COUNT "${HEX_LENGTH} / 2")

# "0x61,0x62,..." with a line break every 16 bytes to keep the header readable.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX_CONTENT}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " BYTES "${BYTES}")

get_filename_component(INPUT_NAME "${INPUT}" NAME)
file(WRITE "${OUTPUT}"
"/* Generated by cmake/EmbedFile.cmake from ${INPUT_NAME}. Do not edit. */
#ifndef EMBED_${SYMBOL}_H
#define EMBED_${SYMBOL}_H

static const unsigned char ${SYMBOL}[] = {
    ${BYTES}0x00
};
static const unsigned int ${SYMBOL}_len = ${BYTE_COUNT}u;

#endif
")
