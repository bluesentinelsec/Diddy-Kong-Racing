# ignore all rom files
*.z64
*.n64
*.v64

build/*
build/


#binaries ripped from the ROMs
assets/*
assets_*/
assets_*/*
bin/
bin/*

# Asset enums, since it is auto-generated.

#compiled object files
*.slo
*.lo
*.o
*.obj

#Precompiled Headers
*.gch
*.pch

#compiled dynamic libraries
*.so
*.dylib
*.dll

#static libraries
*.lai
*.la
*.a
*.lib

#Windows stuff
*.bat
*.exe

#misc
__pycache__/
expected/
.*/
*.d
*.DS_Store
dkracing
dkracing.elf
log.txt

# GitHub Actions workflows (the upstream rule above ignores every dot-directory)
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Doxygen output (make doc); the hand-written guides beside it in docs/ are tracked
docs/html/

# The Gradle wrapper's Windows launcher (the *.bat rule above would drop it)
!android/gradlew.bat
# Native Windows equivalent of the root Makefile wrapper.
!build-windows.bat
